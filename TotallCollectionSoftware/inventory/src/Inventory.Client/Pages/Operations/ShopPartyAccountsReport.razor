@page "/operations/reports/party-accounts"
@page "/shop/party-accounts"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IPartyService PartySvc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>گزارش حساب و کتاب طرف حساب‌ها (بدهکار و بستانکار)</PageTitle>

<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>گزارش حساب و کتاب (بدهکار و بستانکار)
        </h1>
        <div class="text-muted fs-8">
            صورت‌وضعیت کامل بدهکاران و بستانکاران فروشگاه شامل افتتاح حساب (مانده اول دوره)، فاکتورهای خرید و فروش، چک‌ها، اقساط و دریافت/پرداخت‌ها
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 d-print-none">
        <a class="btn btn-outline-primary btn-sm" href="/shop/opening-balances">
            <i class="bi bi-journal-plus me-1"></i> ثبت / ویرایش افتتاح حساب
        </a>
        <button class="btn btn-outline-secondary btn-sm" @onclick="PrintReportAsync" disabled="@(report is null)">
            <i class="bi bi-printer me-1"></i> چاپ گزارش
        </button>
        <button class="btn btn-light btn-sm border" @onclick="LoadReportAsync" disabled="@loading">
            <i class="bi bi-arrow-clockwise"></i> به‌روزرسانی
        </button>
    </div>
</div>

@* ---------- فیلترهای گزارش حساب و کتاب ---------- *@
<div class="card shadow-sm border-0 mb-3 d-print-none">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label">جستجوی طرف حساب</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input class="form-control" placeholder="نام، موبایل، تلفن یا شرح..."
                           @bind="search" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">نوع طرف حساب</label>
                <select class="form-select" @bind="typeFilterStr" @bind:after="LoadReportAsync">
                    <option value="">همه (مشتری و تأمین‌کننده)</option>
                    <option value="0">فقط مشتریان</option>
                    <option value="1">فقط تأمین‌کنندگان</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">وضعیت حساب و کتاب</label>
                <select class="form-select" @bind="statusFilter" @bind:after="LoadReportAsync">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="debtor">فقط بدهکاران (طلب ما)</option>
                    <option value="creditor">فقط بستانکاران (بدهی ما)</option>
                    <option value="opening">دارای افتتاح حساب (اول دوره)</option>
                    <option value="active_account">دارای گردش یا مانده</option>
                    <option value="settled">تسویه‌شده (بی‌حساب)</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">از تاریخ</label>
                <DatePicker @bind-Value="fromDate" AllowClear="true" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label">تا تاریخ</label>
                <DatePicker @bind-Value="toDate" AllowClear="true" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@loading" title="اعمال فیلتر">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@if (loading && report is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (report is not null)
{
    @* ---------- کارت‌های شاخص (بدهکار و بستانکار) ---------- *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fs-8 fw-600">جمع کل بدهکاران (طلب ما)</span>
                            <h4 class="fw-800 text-danger num mt-2 mb-0">@FilteredRows.Sum(x => x.ClosingDebit).Money() <span class="fs-8 fw-normal">ریال</span></h4>
                        </div>
                        <div class="badge bg-soft-danger text-danger p-3 rounded-circle">
                            <i class="bi bi-arrow-down-left-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-danger fs-9 fw-bold">
                        @FilteredRows.Count(x => x.Balance > 0).Num() طرف حساب بدهکار به مجموعه
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fs-8 fw-600">جمع کل بستانکاران (بدهی ما)</span>
                            <h4 class="fw-800 text-primary num mt-2 mb-0">@FilteredRows.Sum(x => x.ClosingCredit).Money() <span class="fs-8 fw-normal">ریال</span></h4>
                        </div>
                        <div class="badge bg-soft-primary text-primary p-3 rounded-circle">
                            <i class="bi bi-arrow-up-right-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-primary fs-9 fw-bold">
                        @FilteredRows.Count(x => x.Balance < 0).Num() طرف حساب بستانکار از مجموعه
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fs-8 fw-600">جمع افتتاح حساب (اول دوره)</span>
                            <div class="mt-2">
                                <div class="fs-8 text-danger num fw-bold">بدهکار: @FilteredRows.Sum(x => x.OpeningDebit).Money()</div>
                                <div class="fs-8 text-primary num fw-bold">بستانکار: @FilteredRows.Sum(x => x.OpeningCredit).Money()</div>
                            </div>
                        </div>
                        <div class="badge bg-soft-warning text-warning p-3 rounded-circle">
                            <i class="bi bi-journal-plus fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-muted fs-9">
                        @FilteredRows.Count(x => x.OpeningDebit > 0 || x.OpeningCredit > 0).Num() طرف حساب دارای مانده اول دوره
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            @{
                var net = FilteredRows.Sum(x => x.ClosingDebit) - FilteredRows.Sum(x => x.ClosingCredit);
            }
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fs-8 fw-600">تراز خالص حساب و کتاب</span>
                            <h4 class="fw-800 @(net > 0 ? "text-danger" : net < 0 ? "text-primary" : "text-success") num mt-2 mb-0">
                                @Math.Abs(net).Money()
                                <span class="fs-8 fw-normal">@(net > 0 ? "بدهکار (طلب خالص)" : net < 0 ? "بستانکار (بدهی خالص)" : "تراز")</span>
                            </h4>
                        </div>
                        <div class="badge bg-soft-success text-success p-3 rounded-circle">
                            <i class="bi bi-calculator-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-muted fs-9">
                        کل طرف‌حساب‌ها: @FilteredRows.Count.Num() (@FilteredRows.Count(x => x.Balance == 0).Num() تسویه)
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- تب‌های سریع تفکیک بدهکاران و بستانکاران ---------- *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom-0 pb-0 pt-3 d-print-none">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <button class="nav-link @(quickTab == TabAll ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick="SetTabAll">
                        همه طرف حساب‌ها
                        <span class="badge bg-light text-dark ms-1 num">@BaseFilteredRows.Count.Num()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(quickTab == TabDebtors ? "active fw-bold text-danger" : "text-secondary")"
                            @onclick="SetTabDebtors">
                        <i class="bi bi-arrow-down-left text-danger me-1"></i> بدهکاران (بدهکار به ما)
                        <span class="badge bg-soft-danger text-danger ms-1 num">@BaseFilteredRows.Count(x => x.Balance > 0).Num()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(quickTab == TabCreditors ? "active fw-bold text-primary" : "text-secondary")"
                            @onclick="SetTabCreditors">
                        <i class="bi bi-arrow-up-right text-primary me-1"></i> بستانکاران (طلبکار از ما)
                        <span class="badge bg-soft-primary text-primary ms-1 num">@BaseFilteredRows.Count(x => x.Balance < 0).Num()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(quickTab == TabOpening ? "active fw-bold text-dark" : "text-secondary")"
                            @onclick="SetTabOpening">
                        <i class="bi bi-journal-plus me-1"></i> دارای افتتاح حساب
                        <span class="badge bg-light text-dark ms-1 num">@BaseFilteredRows.Count(x => x.OpeningDebit > 0 || x.OpeningCredit > 0).Num()</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-0">
            @if (FilteredRows.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-50"></i>
                    <span>هیچ طرف حسابی با شرایط انتخابی یافت نشد.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light fs-8">
                            <tr>
                                <th>طرف حساب</th>
                                <th>نوع</th>
                                <th class="text-start border-start">بدهکار اول دوره</th>
                                <th class="text-start">بستانکار اول دوره</th>
                                <th class="text-start border-start">گردش بدهکار دوره</th>
                                <th class="text-start">گردش بستانکار دوره</th>
                                <th class="text-start border-start">جمع کل بدهکار</th>
                                <th class="text-start">جمع کل بستانکار</th>
                                <th class="text-start border-start">مانده بدهکار (ریال)</th>
                                <th class="text-start">مانده بستانکار (ریال)</th>
                                <th class="text-center">وضعیت حساب</th>
                                <th class="text-end d-print-none">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in FilteredRows)
                            {
                                var row = r;
                                <tr class="@(row.Balance > 0 ? "table-danger-subtle" : row.Balance < 0 ? "table-primary-subtle" : "")">
                                    <td>
                                        <div class="fw-bold">@row.PartyName</div>
                                        @if (!string.IsNullOrWhiteSpace(row.Mobile) || !string.IsNullOrWhiteSpace(row.Phone))
                                        {
                                            <div class="fs-9 text-muted num">@(row.Mobile ?? row.Phone)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.OpeningDescription))
                                        {
                                            <div class="fs-9 text-muted"><i class="bi bi-journal-plus"></i> @row.OpeningDescription</div>
                                        }
                                    </td>
                                    <td>
                                        @if (row.PartyType == PartyType.Customer)
                                        {
                                            <span class="badge bg-soft-info text-info">مشتری</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-soft-warning text-warning">تأمین‌کننده</span>
                                        }
                                    </td>
                                    <td class="text-start num border-start @(row.OpeningDebit > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @(row.OpeningDebit > 0 ? row.OpeningDebit.Money() : "—")
                                    </td>
                                    <td class="text-start num @(row.OpeningCredit > 0 ? "text-primary fw-bold" : "text-muted")">
                                        @(row.OpeningCredit > 0 ? row.OpeningCredit.Money() : "—")
                                    </td>
                                    <td class="text-start num border-start @(row.PeriodDebit > 0 ? "text-dark" : "text-muted")">
                                        @(row.PeriodDebit > 0 ? row.PeriodDebit.Money() : "—")
                                    </td>
                                    <td class="text-start num @(row.PeriodCredit > 0 ? "text-dark" : "text-muted")">
                                        @(row.PeriodCredit > 0 ? row.PeriodCredit.Money() : "—")
                                    </td>
                                    <td class="text-start num border-start fw-600 @(row.TotalDebit > 0 ? "text-danger" : "text-muted")">
                                        @(row.TotalDebit > 0 ? row.TotalDebit.Money() : "۰")
                                    </td>
                                    <td class="text-start num fw-600 @(row.TotalCredit > 0 ? "text-primary" : "text-muted")">
                                        @(row.TotalCredit > 0 ? row.TotalCredit.Money() : "۰")
                                    </td>
                                    <td class="text-start num border-start fw-800 @(row.ClosingDebit > 0 ? "text-danger" : "text-muted")">
                                        @(row.ClosingDebit > 0 ? row.ClosingDebit.Money() : "۰")
                                    </td>
                                    <td class="text-start num fw-800 @(row.ClosingCredit > 0 ? "text-primary" : "text-muted")">
                                        @(row.ClosingCredit > 0 ? row.ClosingCredit.Money() : "۰")
                                    </td>
                                    <td class="text-center">
                                        @if (row.Balance > 0)
                                        {
                                            <span class="badge bg-danger text-white">بدهکار</span>
                                        }
                                        else if (row.Balance < 0)
                                        {
                                            <span class="badge bg-primary text-white">بستانکار</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-soft-success text-success">تسویه</span>
                                        }
                                    </td>
                                    <td class="text-end d-print-none">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    title="مشاهده ریز گردش حساب (دفتر حساب و کتاب طرف حساب)"
                                                    @onclick="() => OpenLedgerAsync(row.PartyId)">
                                                <i class="bi bi-card-list"></i> ریز گردش
                                            </button>
                                            <button type="button" class="btn btn-sm btn-light border"
                                                    title="ثبت / ویرایش سریع افتتاح حساب"
                                                    @onclick="() => OpenQuickOpeningModal(row)">
                                                <i class="bi bi-journal-plus text-primary"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="2" class="text-end">جمع کل:</td>
                                <td class="text-start num border-start text-danger">@FilteredRows.Sum(x => x.OpeningDebit).Money()</td>
                                <td class="text-start num text-primary">@FilteredRows.Sum(x => x.OpeningCredit).Money()</td>
                                <td class="text-start num border-start">@FilteredRows.Sum(x => x.PeriodDebit).Money()</td>
                                <td class="text-start num">@FilteredRows.Sum(x => x.PeriodCredit).Money()</td>
                                <td class="text-start num border-start text-danger">@FilteredRows.Sum(x => x.TotalDebit).Money()</td>
                                <td class="text-start num text-primary">@FilteredRows.Sum(x => x.TotalCredit).Money()</td>
                                <td class="text-start num border-start text-danger">@FilteredRows.Sum(x => x.ClosingDebit).Money()</td>
                                <td class="text-start num text-primary">@FilteredRows.Sum(x => x.ClosingCredit).Money()</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ---------- مودال ریز گردش حساب و کتاب یک طرف حساب ---------- *@
<Modal Visible="showLedgerModal" Title="@(ledger is not null ? $"ریز گردش حساب و کتاب: {ledger.PartyName}" : "ریز گردش حساب")"
       Size="modal-xl" OnClose="CloseLedgerModal">
    <ChildContent>
        @if (ledgerLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (ledger is not null)
        {
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 bg-light">
                        <div class="fs-9 text-muted">مانده اول دوره (افتتاح حساب)</div>
                        <div class="fw-bold num @(ledger.OpeningDebit > 0 ? "text-danger" : ledger.OpeningCredit > 0 ? "text-primary" : "text-muted")">
                            @if (ledger.OpeningDebit > 0)
                            {
                                <span>@ledger.OpeningDebit.Money() بدهکار</span>
                            }
                            else if (ledger.OpeningCredit > 0)
                            {
                                <span>@ledger.OpeningCredit.Money() بستانکار</span>
                            }
                            else
                            {
                                <span>۰ (بدون اول دوره)</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 bg-light">
                        <div class="fs-9 text-muted">جمع کل بدهکار</div>
                        <div class="fw-bold num text-danger">@ledger.TotalDebit.Money() ریال</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 bg-light">
                        <div class="fs-9 text-muted">جمع کل بستانکار</div>
                        <div class="fw-bold num text-primary">@ledger.TotalCredit.Money() ریال</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 @(ledger.ClosingBalance > 0 ? "bg-danger-subtle" : ledger.ClosingBalance < 0 ? "bg-primary-subtle" : "bg-success-subtle")">
                        <div class="fs-9 text-muted">مانده نهایی طرف حساب</div>
                        <div class="fw-800 num @(ledger.ClosingBalance > 0 ? "text-danger" : ledger.ClosingBalance < 0 ? "text-primary" : "text-success")">
                            @Math.Abs(ledger.ClosingBalance).Money() ریال (@ledger.ClosingStatus)
                        </div>
                    </div>
                </div>
            </div>

            @if (ledger.Rows.Count == 0)
            {
                <div class="text-center py-4 text-muted">هیچ گردشی برای این طرف حساب ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover align-middle mb-0">
                        <thead class="table-light fs-8">
                            <tr>
                                <th style="width:45px">#</th>
                                <th>تاریخ</th>
                                <th>شماره سند</th>
                                <th>نوع عملیات</th>
                                <th>شرح</th>
                                <th class="text-start">بدهکار (ریال)</th>
                                <th class="text-start">بستانکار (ریال)</th>
                                <th class="text-start">مانده لحظه‌ای (ریال)</th>
                                <th class="text-center">تشخیص</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var idx = 1; }
                            @foreach (var item in ledger.Rows)
                            {
                                <tr class="@(item.IsOpening ? "table-warning-subtle fw-bold" : "")">
                                    <td class="num text-muted">@((idx++).Num())</td>
                                    <td class="num fs-8">@(item.Date == DateTime.MinValue ? "اول دوره" : item.Date.ToFaDate())</td>
                                    <td class="num fw-600">@item.DocNumber</td>
                                    <td><span class="badge bg-light text-dark border">@item.KindTitle</span></td>
                                    <td class="fs-8">@item.Description</td>
                                    <td class="text-start num @(item.Debit > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @(item.Debit > 0 ? item.Debit.Money() : "—")
                                    </td>
                                    <td class="text-start num @(item.Credit > 0 ? "text-primary fw-bold" : "text-muted")">
                                        @(item.Credit > 0 ? item.Credit.Money() : "—")
                                    </td>
                                    <td class="text-start num fw-bold @(item.RunningBalance > 0 ? "text-danger" : item.RunningBalance < 0 ? "text-primary" : "text-success")">
                                        @Math.Abs(item.RunningBalance).Money()
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.RunningBalance > 0 ? "bg-soft-danger text-danger" : item.RunningBalance < 0 ? "bg-soft-primary text-primary" : "bg-soft-success text-success")">
                                            @item.BalanceStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5" class="text-end">جمع کل گردش و مانده نهایی:</td>
                                <td class="text-start num text-danger">@ledger.TotalDebit.Money()</td>
                                <td class="text-start num text-primary">@ledger.TotalCredit.Money()</td>
                                <td class="text-start num">@Math.Abs(ledger.ClosingBalance).Money()</td>
                                <td class="text-center">@ledger.ClosingStatus</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseLedgerModal">بستن</button>
        <button class="btn btn-primary" @onclick="PrintReportAsync">
            <i class="bi bi-printer"></i> چاپ صورت‌حساب
        </button>
    </Footer>
</Modal>

@* ---------- مودال ویرایش سریع افتتاح حساب در همین گزارش ---------- *@
<Modal Visible="showQuickOpeningModal" Title="@($"افتتاح حساب (اول دوره): {quickOpeningPartyName}")"
       OnClose="CloseQuickOpeningModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">وضعیت حساب در ابتدای دوره</label>
                <div class="btn-group w-100" role="group">
                    <button type="button"
                            class="btn @(quickOpeningSide == SideDebit ? "btn-danger" : "btn-outline-danger")"
                            @onclick="SetQuickSideDebit">
                        بدهکار (بدهکار به ما)
                    </button>
                    <button type="button"
                            class="btn @(quickOpeningSide == SideCredit ? "btn-primary" : "btn-outline-primary")"
                            @onclick="SetQuickSideCredit">
                        بستانکار (طلبکار از ما)
                    </button>
                    <button type="button"
                            class="btn @(quickOpeningSide == SideZero ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="SetQuickSideZero">
                        بی‌حساب (صفر)
                    </button>
                </div>
            </div>
            @if (quickOpeningSide != SideZero)
            {
                <div class="col-12 col-md-6">
                    <label class="form-label">مبلغ اول دوره (ریال)</label>
                    <input class="form-control num fw-bold" dir="ltr" inputmode="numeric"
                           value="@quickOpeningAmountText"
                           @oninput="OnQuickOpeningAmountInput" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">تاریخ افتتاح حساب</label>
                    <DatePicker @bind-Value="quickOpeningDate" AllowClear="true" />
                </div>
                <div class="col-12">
                    <label class="form-label">شرح افتتاح حساب</label>
                    <input class="form-control" @bind="quickOpeningDesc"
                           placeholder="مثلاً: مانده حساب انتقالی از دفتر قبلی" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseQuickOpeningModal">انصراف</button>
        <button class="btn btn-primary" @onclick="SaveQuickOpeningAsync" disabled="@savingQuickOpening">
            @if (savingQuickOpening)
            {
                <span class="spinner-border spinner-border-sm ms-1"></span>
            }
            ذخیره افتتاح حساب
        </button>
    </Footer>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "partyId")] public int? QueryPartyId { get; set; }

    private const string TabAll = "all";
    private const string TabDebtors = "debtors";
    private const string TabCreditors = "creditors";
    private const string TabOpening = "opening";

    private const string SideDebit = "debit";
    private const string SideCredit = "credit";
    private const string SideZero = "zero";

    private ShopPartyAccountsReportDto? report;
    private bool loading = true;

    private string search = "";
    private string typeFilterStr = "";
    private string statusFilter = "";
    private string quickTab = TabAll;
    private DateTime? fromDate;
    private DateTime? toDate;

    // مودال ریز گردش حساب
    private bool showLedgerModal;
    private bool ledgerLoading;
    private ShopPartyLedgerDto? ledger;

    // مودال ویرایش سریع افتتاح حساب
    private bool showQuickOpeningModal;
    private bool savingQuickOpening;
    private int quickOpeningPartyId;
    private string quickOpeningPartyName = "";
    private string quickOpeningSide = SideDebit;
    private string quickOpeningAmountText = "";
    private DateTime? quickOpeningDate = DateTime.Today;
    private string? quickOpeningDesc;

    private List<ShopPartyAccountRow> BaseFilteredRows
    {
        get
        {
            if (report is null) return new List<ShopPartyAccountRow>();
            IEnumerable<ShopPartyAccountRow> q = report.Items;
            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim().ToLowerInvariant();
                q = q.Where(r => r.PartyName.ToLowerInvariant().Contains(s)
                                 || (r.Mobile != null && r.Mobile.Contains(s))
                                 || (r.Phone != null && r.Phone.Contains(s))
                                 || (r.OpeningDescription != null && r.OpeningDescription.ToLowerInvariant().Contains(s)));
            }
            return q.ToList();
        }
    }

    private List<ShopPartyAccountRow> FilteredRows
    {
        get
        {
            IEnumerable<ShopPartyAccountRow> q = BaseFilteredRows;
            if (quickTab == TabDebtors)
                q = q.Where(x => x.Balance > 0);
            else if (quickTab == TabCreditors)
                q = q.Where(x => x.Balance < 0);
            else if (quickTab == TabOpening)
                q = q.Where(x => x.OpeningDebit > 0 || x.OpeningCredit > 0);

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
        if (QueryPartyId is > 0)
            await OpenLedgerAsync(QueryPartyId.Value);
    }

    private void SetTabAll() => quickTab = TabAll;
    private void SetTabDebtors() => quickTab = TabDebtors;
    private void SetTabCreditors() => quickTab = TabCreditors;
    private void SetTabOpening() => quickTab = TabOpening;

    private void SetQuickSideDebit() => quickOpeningSide = SideDebit;
    private void SetQuickSideCredit() => quickOpeningSide = SideCredit;
    private void SetQuickSideZero() => quickOpeningSide = SideZero;

    private void OnQuickOpeningAmountInput(ChangeEventArgs e)
    {
        quickOpeningAmountText = Fa.FormatTyping(e.Value?.ToString() ?? "");
    }

    private async Task LoadReportAsync()
    {
        loading = true;
        try
        {
            PartyType? pt = null;
            if (int.TryParse(typeFilterStr, out var ptInt))
                pt = (PartyType)ptInt;

            report = await PartySvc.GetAccountsReportAsync(pt, statusFilter, fromDate, toDate, null);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenLedgerAsync(int partyId)
    {
        showLedgerModal = true;
        ledgerLoading = true;
        ledger = null;
        try
        {
            ledger = await PartySvc.GetPartyLedgerAsync(partyId, fromDate, toDate);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
            showLedgerModal = false;
        }
        finally
        {
            ledgerLoading = false;
        }
    }

    private void CloseLedgerModal()
    {
        showLedgerModal = false;
        ledger = null;
    }

    private void OpenQuickOpeningModal(ShopPartyAccountRow row)
    {
        quickOpeningPartyId = row.PartyId;
        quickOpeningPartyName = row.PartyName;
        if (row.OpeningCredit > 0)
        {
            quickOpeningSide = SideCredit;
            quickOpeningAmountText = Fa.FormatTyping(row.OpeningCredit.ToString("0"));
        }
        else if (row.OpeningDebit > 0)
        {
            quickOpeningSide = SideDebit;
            quickOpeningAmountText = Fa.FormatTyping(row.OpeningDebit.ToString("0"));
        }
        else
        {
            quickOpeningSide = row.PartyType == PartyType.Supplier ? SideCredit : SideDebit;
            quickOpeningAmountText = "";
        }
        quickOpeningDate = row.OpeningDate ?? DateTime.Today;
        quickOpeningDesc = string.IsNullOrWhiteSpace(row.OpeningDescription)
            ? "مانده حساب اول دوره (افتتاح حساب)"
            : row.OpeningDescription;
        showQuickOpeningModal = true;
    }

    private void CloseQuickOpeningModal() => showQuickOpeningModal = false;

    private async Task SaveQuickOpeningAsync()
    {
        savingQuickOpening = true;
        try
        {
            var amt = Fa.ParseDecimal(quickOpeningAmountText);
            await PartySvc.SaveOpeningBalanceAsync(new PartyOpeningBalanceCommand
            {
                PartyId = quickOpeningPartyId,
                OpeningDebit = quickOpeningSide == SideDebit ? amt : 0m,
                OpeningCredit = quickOpeningSide == SideCredit ? amt : 0m,
                OpeningDate = quickOpeningSide == SideZero ? null : (quickOpeningDate ?? DateTime.Today),
                OpeningDescription = quickOpeningSide == SideZero ? null : quickOpeningDesc
            });
            Toast.Success("افتتاح حساب به‌روزرسانی شد.");
            showQuickOpeningModal = false;
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            savingQuickOpening = false;
        }
    }

    private async Task PrintReportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ltxPrint");
        }
        catch { }
    }
}
