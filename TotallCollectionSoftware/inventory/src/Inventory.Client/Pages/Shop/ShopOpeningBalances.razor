    private async Task SaveInitialStockAsync()
    {
        if (stockWarehouseId <= 0) { Toast.Error("انبار را انتخاب کنید."); return; }
        if (stockProductId <= 0) { Toast.Error("کالا را انتخاب کنید."); return; }
        var qty = Fa.ParseDecimal(stockQuantityText);
        if (qty < 0) { Toast.Error("مقدار موجودی نمی‌تواند منفی باشد."); return; }

        savingStock = true;
        try
        {
            await StockSvc.AdjustAsync(new AdjustmentCommand
            {
                WarehouseId = stockWarehouseId,
                ProductId = stockProductId,
                Quantity = qty,
                Date = stockDate ?? DateTime.Today,
                Description = string.IsNullOrWhiteSpace(stockDescription) ? "موجودی اول دوره انبار" : stockDescription
            });
            Toast.Success("موجودی اول دوره کالا ثبت شد.");
            stockQuantityText = "";
            await LoadGoodsTabAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            savingStock = false;
        }
    }
}
